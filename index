// ==================== AUTH ====================
function openAuthModal(tab = 'login') {
document.getElementById('authModalOverlay').classList.remove('hidden');
switchAuthTab(tab);
}

function closeAuthModal() {
document.getElementById('authModalOverlay').classList.add('hidden');
document.getElementById('authOTPSection').style.display = 'none';
}

function switchAuthTab(tab) {
document.getElementById('authLoginForm').style.display = tab === 'login' ? 'block' : 'none';
document.getElementById('authSignupForm').style.display = tab === 'signup' ? 'block' : 'none';
document.getElementById('authOTPSection').style.display = 'none';
}

function handleLogin(e) {
e.preventDefault();
const identifier = document.getElementById('loginIdentifier').value.trim();
if (!identifier) { showToast('Please enter email or mobile.'); return; }
// Simulate OTP
document.getElementById('authLoginForm').style.display = 'none';
document.getElementById('authSignupForm').style.display = 'none';
document.getElementById('authOTPSection').style.display = 'block';
showToast('📱 OTP sent to your registered mobile number! (Simulated: use 123456)');
}

function handleSignup(e) {
e.preventDefault();
const name = document.getElementById('signupName').value.trim();
const email = document.getElementById('signupEmail').value.trim();
const mobile = document.getElementById('signupMobile').value.trim();
const role = document.getElementById('signupRole').value;
if (!name || !email || !mobile || !role) { showToast('Please fill all fields.'); return; }
document.getElementById('authLoginForm').style.display = 'none';
document.getElementById('authSignupForm').style.display = 'none';
document.getElementById('authOTPSection').style.display = 'block';
showToast('📱 OTP sent to ' + mobile + '! (Simulated: use 123456)');
// Store pending user
window._pendingUser = { name, email, mobile, role };
}

function verifyOTP(e) {
e.preventDefault();
const otp = document.getElementById('otpInput').value.trim();
if (otp === '123456') {
isLoggedIn = true;
currentUser = window._pendingUser || { name: 'User', email: document.getElementById(
'loginIdentifier')?.value || 'user@email.com', role: 'client' };
closeAuthModal();
showToast('✅ Verified successfully! Welcome, ' + currentUser.name + '!');
document.getElementById('authOTPSection').style.display = 'none';
// If there was a pending property detail view
if (pendingPropertyDetail) {
const prop = pendingPropertyDetail;
pendingPropertyDetail = null;
setTimeout(() => viewPropertyDetail(prop.id), 400);
}
// Refresh property grids
if (currentPage === 'home') renderPropertyGrid('propertyGrid', allProperties);
if (currentPage === 'properties') renderAllProperties();
} else {
showToast('❌ Invalid OTP. Please try again. (Hint: 123456)');
}
}


<span>📐 ${p.carpet} sq.ft.</span>
<span>🏗️ ${p.builder}</span>
</div>
${!isLoggedIn ? '<p style="color:var(--danger);font-size:0.78rem;margin-top:8px;">🔒 Login required for brochure & contact</p>' : '<p style="color:var(--success);font-size:0.78rem;margin-top:8px;">✅ Full details unlocked</p>'}
